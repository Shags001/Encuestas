<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootEstadisticas"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blanco_crema"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".EstadisticasActivity">

    <!-- Toolbar con Botón Volver al Panel -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/barraSuperior"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/cafe_oscuro"
        app:navigationIcon="@drawable/ic_back"
        app:title="3. Estadisticas - Panel"
        app:titleTextColor="@color/blanco_crema" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Selector Libre de Encuesta / Sucursal -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Seleccionar Encuesta o Sucursal a Consultar:"
                android:textColor="@color/cafe_negro"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/marron_tostado"
                app:strokeWidth="1.5dp">

                <Spinner
                    android:id="@+id/spSeleccionarEncuestaEstadisticas"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:spinnerMode="dropdown" />
            </com.google.android.material.card.MaterialCardView>

            <!-- SECCIÓN A: SEMÁFORO Y PROMEDIO DE CALIDAD (Preguntas de Escala) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tarjetaResumenGeneral"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Semáforo y Promedios de Calidad (Escalas)"
                        android:textColor="@color/cafe_negro"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Etiqueta Turno (tvEtiquetaTurno) -->
                    <TextView
                        android:id="@+id/tvEtiquetaTurno"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Turno: Mañana | Total Encuestados: 15"
                        android:textColor="@color/cafe_oscuro"
                        android:textSize="13sp" />

                    <!-- Nota Promedio (tvNotaPromedio) -->
                    <TextView
                        android:id="@+id/tvNotaPromedio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="8dp"
                        android:text="8.5 / 10.0"
                        android:textColor="@color/cafe_negro"
                        android:textSize="36sp"
                        android:textStyle="bold" />

                    <!-- Indicador Visual del Semáforo (vistaSemaforo) -->
                    <View
                        android:id="@+id/vistaSemaforo"
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:layout_gravity="center"
                        android:background="@drawable/shape_circle"
                        android:backgroundTint="@color/semaforo_verde_on" />

                    <!-- Diagnóstico del Semáforo (tvEstadoSemaforo) -->
                    <TextView
                        android:id="@+id/tvEstadoSemaforo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:text="Servicio Óptimo - Excelente nivel de calidad"
                        android:textColor="@color/cafe_negro"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <!-- Contenedor Gráficas de Escala (containerGraficaEscalas) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp"
                        android:text="Comparativa de Calidad por Pregunta:"
                        android:textColor="@color/cafe_negro"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/containerGraficaEscalas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SECCIÓN B: ÍNDICE DE CUMPLIMIENTO Y APROBACIÓN (Preguntas Sí / No) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Índice de Aprobación y Cumplimiento (Sí / No)"
                        android:textColor="@color/cafe_negro"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPorcentajeAprobacion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="12dp"
                        android:text="92% Aprobación General"
                        android:textColor="@color/cafe_negro"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <!-- Contenedor Gráficas Sí / No (containerGraficaSiNo) -->
                    <LinearLayout
                        android:id="@+id/containerGraficaSiNo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SECCIÓN C: NOTAS Y JUSTIFICANTES DE BITÁCORA -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="Observaciones y Justificantes del Turno"
                        android:textColor="@color/cafe_negro"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/containerNotasJustificantes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>